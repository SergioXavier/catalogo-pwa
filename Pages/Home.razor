@page "/"
@inject HttpClient Http

<PageTitle>O Nosso Catálogo</PageTitle>
<div class="container text-center my-4">
<h1 class="display-4 fw-bold text-primary">Catálogo Semanal</h1>
<p class="text-muted">Consulte os nossos produtos mesmo sem internet!</p>
</div>

@if (produtos == null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-4 g-3 p-2">
        @foreach (var prod in produtos)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@prod.Imagem" class="card-img-top p-2" alt="@prod.Nome" style="object-fit:contain; height:150px;" />
                    <div class="card-body d-flex flex-column justify-content-between p-2">
                        <h6 class="card-title text-dark m-0 text-truncate">@prod.Nome</h6>
                        <p class="card-text fw-bold text-success m-0 mt-1">@prod.Preco.ToString("C")</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Produto>? produtos;
    protected override async Task OnInitializedAsync()
    {
        //O Blazor lê o ficheiro local. A PWA encarrega-se de o guardar em cache offline.
        produtos = await Http.GetFromJsonAsync<List<Produto>>("produtos.json");
    }

    public class Produto
    {
        public int Id {get; set;}
        public string Nome {get; set;}=string.Empty;
        public decimal Preco {get; set;}
        public string Imagem {get; set;}=string.Empty;
    }
}